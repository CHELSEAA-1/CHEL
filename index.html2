--// =========================================================================
--// CHARACTER, TWEEN & CURSOR HELPERS
--// =========================================================================
local function GetCharacter()
	return LocalPlayer.Character
end

local function GetHumanoid()
	local char = GetCharacter()
	return char and char:FindFirstChildOfClass("Humanoid")
end

local function GetRootPart()
	local char = GetCharacter()
	return char and (char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart)
end

local function GetEffectiveTweenSpeed()
	if State.SyncTweenToWalkSpeed then
		return math.max(10, State.WalkSpeed * State.TweenSpeedMultiplier)
	end
	return math.max(10, State.TweenSpeed)
end

local function StopActiveTween()
	State.TweenLoopActive = false
	if State.ActiveTween then
		pcall(function() State.ActiveTween:Cancel() end)
		State.ActiveTween = nil
	end
end

local function TweenToCFrame(targetCFrame, customSpeed)
	local root = GetRootPart()
	if not root then return nil end
	if State.ActiveTween then
		pcall(function() State.ActiveTween:Cancel() end)
		State.ActiveTween = nil
	end
	local speed = customSpeed or GetEffectiveTweenSpeed()
	local distance = (targetCFrame.Position - root.Position).Magnitude
	local duration = math.max(0.05, distance / speed)
	local info = TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
	local tween = TweenService:Create(root, info, { CFrame = targetCFrame })
	State.ActiveTween = tween
	tween:Play()
	SetStatus(string.format("Tweening %.0f studs @ %d spd (%.2fs)", distance, speed, duration))
	return tween
end

local function FindNearestPlayerRoot()
	local root = GetRootPart()
	if not root then return nil, nil, math.huge end
	local nearestRoot, nearestPlr, bestDist = nil, nil, math.huge
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and plr.Character then
			local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
			if hrp then
				local d = (hrp.Position - root.Position).Magnitude
				if d < bestDist then
					bestDist = d
					nearestRoot = hrp
					nearestPlr = plr
				end
			end
		end
	end
	return nearestRoot, nearestPlr, bestDist
end

local function PerformCursorClickAt(screenX, screenY, guiObj)
	local now = os.clock()
	if (now - State.LastClickTick) * 1000 < State.ClickCooldownMs then
		return false
	end
	State.LastClickTick = now
	State.TrainClickCount = State.TrainClickCount + 1

	local inset = GuiService:GetGuiInset()
	local finalX = math.floor(screenX + inset.X)
	local finalY = math.floor(screenY + inset.Y)
	local clicked = false

	if VirtualInputManager then
		local ok = pcall(function()
			VirtualInputManager:SendMouseMoveEvent(finalX, finalY, game)
			VirtualInputManager:SendMouseButtonEvent(finalX, finalY, 0, true, game, 1)
			task.defer(function()
				pcall(function()
					VirtualInputManager:SendMouseButtonEvent(finalX, finalY, 0, false, game, 1)
				end)
			end)
		end)
		if ok then clicked = true end
	end

	if guiObj and (guiObj:IsA("TextButton") or guiObj:IsA("ImageButton")) then
		pcall(function()
			if type(firesignal) == "function" then
				firesignal(guiObj.MouseButton1Click)
				firesignal(guiObj.Activated)
			end
		end)
	end

	if not clicked and VirtualUser then
		pcall(function()
			VirtualUser:CaptureController()
			VirtualUser:ClickButton1(Vector2.new(finalX, finalY))
		end)
	end
	return true
end

--// =========================================================================
--// TYCOON COLLECTOR & UPGRADE AUTOMATION
--// =========================================================================
local function TycoonSafeDelay()
	local jitter = math.random() * (State.TycoonMaxDelay - State.TycoonMinDelay)
	task.wait(State.TycoonMinDelay + jitter)
end

local function FindOwnedTycoon()
	local tycoonsFolder = Workspace:FindFirstChild("Tycoons") or Workspace:FindFirstChild("Bases")
	if not tycoonsFolder then return nil end
	for _, tycoon in ipairs(tycoonsFolder:GetChildren()) do
		local owner = tycoon:FindFirstChild("Owner") or tycoon:GetAttribute("Owner")
		if owner == LocalPlayer or owner == LocalPlayer.Name or owner == LocalPlayer.UserId then
			return tycoon
		end
	end
	return nil
end

local function CollectTycoonCashOnce()
	local root = GetRootPart()
	local tycoon = FindOwnedTycoon()
	if not root or not tycoon or type(firetouchinterest) ~= "function" then return end
	local collector = tycoon:FindFirstChild("Collector", true) or tycoon:FindFirstChild("CashPad", true)
	if collector and collector:IsA("BasePart") then
		pcall(function()
			firetouchinterest(root, collector, 0)
			task.wait(0.04)
			firetouchinterest(root, collector, 1)
		end)
	end
end

local function BuyAvailableTycoonButtons()
	local root = GetRootPart()
	local tycoon = FindOwnedTycoon()
	local buttonsFolder = tycoon and (tycoon:FindFirstChild("Buttons") or tycoon:FindFirstChild("Upgrades"))
	if not root or not buttonsFolder or type(firetouchinterest) ~= "function" then return end

	local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
	local cashStat = leaderstats and (leaderstats:FindFirstChild("Cash") or leaderstats:FindFirstChild("Money"))
	local currentCash = (cashStat and typeof(cashStat.Value) == "number") and cashStat.Value or math.huge

	for _, button in ipairs(buttonsFolder:GetChildren()) do
		if not State.TycoonAutoBuy then break end
		local head = button:FindFirstChild("Head") or (button:IsA("BasePart") and button)
		local costVal = button:FindFirstChild("Cost") or button:FindFirstChild("Price")
		local canAfford = true
		if costVal and typeof(costVal.Value) == "number" then
			canAfford = currentCash >= costVal.Value
		end
		if head and head:IsA("BasePart") and canAfford and head.Transparency < 1 then
			pcall(function()
				firetouchinterest(root, head, 0)
				task.wait(0.04)
				firetouchinterest(root, head, 1)
			end)
			TycoonSafeDelay()
		end
	end
end

task.spawn(function()
	while true do
		if State.TycoonAutoCollect then
			pcall(CollectTycoonCashOnce)
		end
		TycoonSafeDelay()
	end
end)

task.spawn(function()
	while true do
		if State.TycoonAutoBuy then
			pcall(BuyAvailableTycoonButtons)
		end
		task.wait(0.85)
	end
end)

