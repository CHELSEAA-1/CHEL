	{ "Low Cinematic Cam", Vector3.new(0, -1.4, 1.5) },
	{ "Wide Action Cam", Vector3.new(0, 1.8, 3.5) },
	{ "Close Combat Cam", Vector3.new(1.5, 0.3, -1.8) },
}
for _, cp in ipairs(CameraPresets) do
	RegisterCommand("Camera Offset: " .. cp[1], "Camera", "Camera", "Set camera offset preset (" .. cp[1] .. ")", false, function()
		local hum = GetHumanoid()
		if hum then hum.CameraOffset = cp[2] end
	end)
end
RegisterCommand("Auto-Orbit Camera Around Self ON", "Camera", "Camera", "Smoothly rotate camera 360 degrees around your avatar", true, function()
	State.CameraOrbitSelf = true
end)
RegisterCommand("Auto-Orbit Camera Around Self OFF", "Camera", "Camera", "Stop 360-degree camera orbit", true, function()
	State.CameraOrbitSelf = false
	local cam = Workspace.CurrentCamera
	local hum = GetHumanoid()
	if cam and hum then cam.CameraType = Enum.CameraType.Custom cam.CameraSubject = hum end
end)
for _, zDist in ipairs({ 50, 128, 300, 1000, 2500, 10000, 50000 }) do
	RegisterCommand("Set Max Zoom " .. zDist .. " Studs", "Camera", "Camera", "Set CameraMaxZoomDistance to " .. zDist .. " studs", false, function()
		LocalPlayer.CameraMaxZoomDistance = zDist
	end)
end

-- I. Direct Spectate Player Slot 1 to 15 (15)
for pSlot = 1, 15 do
	RegisterCommand("Spectate Player Slot #" .. pSlot, "Camera", "Camera", "Switch camera directly to server player slot #" .. pSlot, false, function()
		local cam = Workspace.CurrentCamera
		if not cam then return end
		local list = {}
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChildOfClass("Humanoid") then
				table.insert(list, plr)
			end
		end
		local target = list[pSlot]
		if target and target.Character then
			cam.CameraSubject = target.Character:FindFirstChildOfClass("Humanoid")
			SetStatus("Spectating " .. target.DisplayName)
		else
			SetStatus("No active player in slot #" .. pSlot)
		end
	end)
end

-- J. 24-Hour ClockTime Lighting Presets (24)
for hr = 0, 23 do
	local formatted = string.format("%02d:00", hr)
	RegisterCommand("World Time " .. formatted, "Visual/ESP", "Visual/ESP", "Set world sky clock time to " .. formatted, false, function()
		Lighting.ClockTime = hr
	end)
end

