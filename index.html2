Aspect16x9.DominantAxis = Enum.DominantAxis.Width
Aspect16x9.Parent = MainFrame

local MainScale = Instance.new("UIScale")
MainScale.Scale = 1
MainScale.Parent = MainFrame

local function UpdateResponsive16x9Scale()
	local cam = Workspace.CurrentCamera
	if not cam then return end
	local vp = cam.ViewportSize
	if vp.X > 0 and vp.Y > 0 then
		local fitW = (vp.X - 24) / 624
		local fitH = (vp.Y - 24) / 351
		local autoFit = math.min(1, fitW, fitH)
		MainScale.Scale = math.clamp(autoFit * State.UserScaleMultiplier, 0.58, 1.25)
	end
end
UpdateResponsive16x9Scale()
if Workspace.CurrentCamera then
	Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(UpdateResponsive16x9Scale)
end

