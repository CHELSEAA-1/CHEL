RegisterCommand("Copy All Server Usernames", "Automation", "Automation", "Copy all player usernames in server to clipboard", false, function()
	local names = {}
	for _, p in ipairs(Players:GetPlayers()) do table.insert(names, p.Name) end
	local str = table.concat(names, ", ")
	if type(setclipboard) == "function" then setclipboard(str) end
	SetStatus("Copied " .. #names .. " usernames")
end)
