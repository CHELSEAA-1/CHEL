local CombatFOVCircle = nil
pcall(function()
	if type(Drawing) == "table" and type(Drawing.new) == "function" then
		CombatFOVCircle = Drawing.new("Circle")
		CombatFOVCircle.Visible = false
		CombatFOVCircle.Thickness = 1.5
		CombatFOVCircle.NumSides = 64
		CombatFOVCircle.Radius = State.CombatFOV
		CombatFOVCircle.Color = Color3.fromRGB(220, 38, 68)
		CombatFOVCircle.Filled = false
		CombatFOVCircle.Transparency = 0.85
	end
end)

local function GetViewportCenter()
	local cam = Workspace.CurrentCamera
	if not cam then return Vector2.new(0, 0) end
	return Vector2.new(cam.ViewportSize.X * 0.5, cam.ViewportSize.Y * 0.5)
end

local function IsValidEnemy(player)
	if not player or player == LocalPlayer then return false end
	if State.CombatTeamCheck and player.Team and LocalPlayer.Team then
		if player.Team == LocalPlayer.Team then
			return false
		end
	end
	return true
end

local function IsTargetVisible(targetPart)
	if not State.CombatWallCheck then return true end
	local cam = Workspace.CurrentCamera
	if not cam or not targetPart then return false end
	local origin = cam.CFrame.Position
	local direction = targetPart.Position - origin
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { GetCharacter(), targetPart.Parent }
	local result = Workspace:Raycast(origin, direction, params)
	return result == nil
end

local function GetClosestCombatTarget(partName)
	local cam = Workspace.CurrentCamera
	if not cam then return nil end
	local closestPart = nil
	local bestDist = State.CombatFOV
	local center = GetViewportCenter()

	for _, player in ipairs(Players:GetPlayers()) do
		if IsValidEnemy(player) then
			local char = player.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			local part = char and (char:FindFirstChild(partName) or char:FindFirstChild("UpperTorso") or char:FindFirstChild("HumanoidRootPart"))
			if hum and hum.Health > 0 and part then
				local screenPos, onScreen = cam:WorldToViewportPoint(part.Position)
				if onScreen and screenPos.Z > 0 then
					local screenPt = Vector2.new(screenPos.X, screenPos.Y)
					local dist = (screenPt - center).Magnitude
					if dist <= bestDist and IsTargetVisible(part) then
						bestDist = dist
						closestPart = part
					end
				end
			end
		end
	end
	return closestPart
end

pcall(function()
	if type(hookmetamethod) ~= "function" then return end
	local wrap = type(newcclosure) == "function" and newcclosure or function(f) return f end

	local oldNamecall
	oldNamecall = hookmetamethod(game, "__namecall", wrap(function(self, ...)
		local method = getnamecallmethod()
		if State.SilentAimEnabled and not checkcaller() and math.random(1, 100) <= State.SilentAimHitChance then
			local targetPart = GetClosestCombatTarget(State.SilentAimPart)
			if targetPart then
				if method == "Raycast" and self == Workspace then
					local args = { ... }
					if typeof(args[1]) == "Vector3" then
						local dist = typeof(args[2]) == "Vector3" and math.max(args[2].Magnitude, 500) or 1000
						args[2] = (targetPart.Position - args[1]).Unit * dist
						return oldNamecall(self, unpack(args))
					end
				elseif (method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList" or method == "FindPartOnRayWithWhitelist") and self == Workspace then
					local args = { ... }
					local ray = args[1]
					if typeof(ray) == "Ray" then
						args[1] = Ray.new(ray.Origin, (targetPart.Position - ray.Origin).Unit * 1000)
						return oldNamecall(self, unpack(args))
					end
				elseif (method == "ViewportPointToRay" or method == "ScreenPointToRay") and self:IsA("Camera") then
					local origin = self.CFrame.Position
					return Ray.new(origin, (targetPart.Position - origin).Unit)
				end
			end
		end
		return oldNamecall(self, ...)
	end))

	local oldIndex
	oldIndex = hookmetamethod(game, "__index", wrap(function(self, key)
		if State.SilentAimEnabled and not checkcaller() and self:IsA("Mouse") then
			if key == "Hit" or key == "Target" then
				local targetPart = GetClosestCombatTarget(State.SilentAimPart)
				if targetPart then
					if key == "Hit" then
						return targetPart.CFrame
					elseif key == "Target" then
						return targetPart
					end
				end
			end
		end
		return oldIndex(self, key)
	end))
end)

--// =========================================================================
--// AUTO PERFECT TIMING HELPER
--// =========================================================================
local function GetPingSeconds()
	local pingSec = 0.04
	pcall(function()
		local pingItem = Stats and Stats.Network and Stats.Network.ServerStatsItem and Stats.Network.ServerStatsItem:FindFirstChild("Data Ping")
		if pingItem and type(pingItem.GetValue) == "function" then
			pingSec = math.clamp(pingItem:GetValue() / 1000, 0.01, 0.35)
		end
	end)
	return pingSec
end

local function ProcessAutoPerfectTiming()
	if not State.AutoPerfectTiming then return end
	local now = os.clock()
	if (now - State.LastTimingTick) < State.TimingCooldown then return end
	local root = GetRootPart()
	if not root then return end

	local pingOffset = GetPingSeconds() * 35
	local effectiveThreshold = State.TimingDistanceThreshold + pingOffset

	for _, obj in ipairs(Workspace:GetDescendants()) do
		if obj:IsA("BasePart") and obj.Anchored == false and not obj:IsDescendantOf(GetCharacter() or Instance.new("Folder")) then
			local dist = (obj.Position - root.Position).Magnitude
			if dist <= effectiveThreshold and obj.AssemblyLinearVelocity.Magnitude > 8 then
				State.LastTimingTick = now
				pcall(function()
					if VirtualInputManager then
						local vp = Workspace.CurrentCamera and Workspace.CurrentCamera.ViewportSize or Vector2.new(500, 500)
						local cx, cy = math.floor(vp.X * 0.5), math.floor(vp.Y * 0.5)
						VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, true, game, 1)
						task.defer(function()
							pcall(function()
								VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, false, game, 1)
							end)
						end)
					elseif VirtualUser then
						VirtualUser:CaptureController()
						VirtualUser:ClickButton1(Vector2.new())
					end
				end)
				break
			end
		end
	end
end

--// =========================================================================
--// AUTO TRAIN MULTIPLIER DETECTOR (1x, 2x, 2.30x, 3x, 4x)
--// =========================================================================
local MultiplierPatterns = {
	["4x"] = { val = 4.0, patterns = { "^4%.?0*x$", "%f[%d]4%.?0*x%f[%A]", "x4%.?0*$" } },
	["3x"] = { val = 3.0, patterns = { "^3%.?0*x$", "%f[%d]3%.?0*x%f[%A]", "x3%.?0*$" } },
	["2.30x"] = { val = 2.3, patterns = { "2%.30*x", "2%.3x", "x2%.30*" } },
	["2x"] = { val = 2.0, patterns = { "^2%.?0*x$", "%f[%d]2%.?0*x%f[%A]", "x2%.?0*$" } },
	["1x"] = { val = 1.0, patterns = { "^1%.?0*x$", "%f[%d]1%.?0*x%f[%A]", "x1%.?0*$" } },
}

local function MatchMultiplierLabel(rawText)
	if not rawText or rawText == "" then return nil, 0 end
	local clean = string.lower(string.gsub(rawText, "%s+", ""))
	if #clean > 18 then return nil, 0 end
	for _, pat in ipairs(MultiplierPatterns["2.30x"].patterns) do
		if string.find(clean, pat) then return "2.30x", 2.3 end
	end
	for _, tag in ipairs({ "4x", "3x", "2x", "1x" }) do
		for _, pat in ipairs(MultiplierPatterns[tag].patterns) do
			if string.find(clean, pat) then return tag, MultiplierPatterns[tag].val end
		end
	end
	return nil, 0
end

local function IsMultiplierAllowed(tag, val)
	if State.AutoTrainFilter == "ALL" then return true
	elseif State.AutoTrainFilter == "2X_PLUS" then return val >= 2.0
	elseif State.AutoTrainFilter == "MAX_ONLY" then return val >= 2.3
	elseif State.AutoTrainFilter == "2X_ONLY" then return tag == "2x" or tag == "2.30x"
	end
	return true
end

local function IsGuiVisibleOnScreen(obj)
	if not obj or not obj:IsA("GuiObject") then return false end
	if not obj.Visible then return false end
	if obj.AbsoluteSize.X < 4 or obj.AbsoluteSize.Y < 4 then return false end
	local curr = obj.Parent
	while curr do
		if curr:IsA("ScreenGui") then return curr.Enabled
		elseif curr:IsA("GuiObject") then
			if not curr.Visible then return false end
		end
		curr = curr.Parent
	end
	return false
end

local function FindMovingIndicatorInContainer(container, zoneObj)
	if not container then return nil end
	local bestIndicator = nil
	for _, child in ipairs(container:GetDescendants()) do
		if child ~= zoneObj and child:IsA("GuiObject") and child.Visible then
			local nameLower = string.lower(child.Name)
			local isCursorName = string.find(nameLower, "cursor") or string.find(nameLower, "needle") or string.find(nameLower, "pointer") or string.find(nameLower, "arrow") or string.find(nameLower, "marker") or string.find(nameLower, "slider") or string.find(nameLower, "line") or string.find(nameLower, "indicator")
			local isThinBar = (child.AbsoluteSize.X >= 1 and child.AbsoluteSize.X <= 18 and child.AbsoluteSize.Y >= 12) or (child.AbsoluteSize.Y >= 1 and child.AbsoluteSize.Y <= 18 and child.AbsoluteSize.X >= 12)
			if isCursorName or isThinBar then
				bestIndicator = child
				if isCursorName then break end
			end
		end
	end
	return bestIndicator
end

local function ProcessAutoTrainCursor()
	if not State.AutoTrainEnabled then return end
	local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
	if not playerGui then return end
	local candidates = {}
	for _, gui in ipairs(playerGui:GetChildren()) do
		if gui:IsA("ScreenGui") and gui.Enabled and gui.Name ~= "ChelseaaSystemV11" then
			for _, desc in ipairs(gui:GetDescendants()) do
				if (desc:IsA("TextLabel") or desc:IsA("TextButton")) and IsGuiVisibleOnScreen(desc) then
					local tag, val = MatchMultiplierLabel(desc.Text)
					if tag and IsMultiplierAllowed(tag, val) then
						table.insert(candidates, { obj = desc, tag = tag, val = val })
					end
				end
			end
		end
	end
	if #candidates == 0 then return end
	table.sort(candidates, function(a, b) return a.val > b.val end)
	for _, item in ipairs(candidates) do
		local obj = item.obj
		local zonePos = obj.AbsolutePosition
		local zoneSize = obj.AbsoluteSize
		local zoneCenterX = zonePos.X + (zoneSize.X * 0.5)
		local zoneCenterY = zonePos.Y + (zoneSize.Y * 0.5)
		local barContainer = obj.Parent and obj.Parent.Parent or obj.Parent
		local indicator = FindMovingIndicatorInContainer(barContainer, obj)
		if indicator and (State.AutoTrainMode == "SMART" or State.AutoTrainMode == "BAR_ALIGN") then
			local indPos = indicator.AbsolutePosition
			local indSize = indicator.AbsoluteSize
			local indCenterX = indPos.X + (indSize.X * 0.5)
			local indCenterY = indPos.Y + (indSize.Y * 0.5)
			local isHorizontal = barContainer and (barContainer.AbsoluteSize.X >= barContainer.AbsoluteSize.Y)
			local dist = isHorizontal and math.abs(indCenterX - zoneCenterX) or math.abs(indCenterY - zoneCenterY)
			local halfZone = isHorizontal and (zoneSize.X * 0.5) or (zoneSize.Y * 0.5)
			if dist <= math.max(State.CursorTolerancePx, halfZone * 0.65) then
				local clickTarget = obj:IsA("TextButton") and obj or (obj.Parent:IsA("GuiButton") and obj.Parent or obj)
				if PerformCursorClickAt(zoneCenterX, zoneCenterY, clickTarget) then
					State.LastDetectedText = item.tag .. " (Bar Align)"
					return
				end
			end
		elseif State.AutoTrainMode == "SMART" or State.AutoTrainMode == "POPUP_CLICK" then
			local clickTarget = obj:IsA("TextButton") and obj or (obj.Parent:IsA("GuiButton") and obj.Parent or obj)
			if PerformCursorClickAt(zoneCenterX, zoneCenterY, clickTarget) then
				State.LastDetectedText = item.tag .. " (Cursor Hit)"
				return
			end
		end
	end
end

--// =========================================================================
--// VISUAL / ESP / AVATAR COSMETICS / BUILDER HELPERS
--// =========================================================================
local function UpdatePlayerESP(enabled)
	State.PlayerESP = enabled
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and plr.Character then
			local existing = plr.Character:FindFirstChild("ChelseaaESP")
			if enabled then
				if not existing then
					local hl = Instance.new("Highlight")
					hl.Name = "ChelseaaESP"
					hl.FillColor = State.ESPFillColor
					hl.OutlineColor = State.ESPOutlineColor
					hl.FillTransparency = 0.5
					hl.OutlineTransparency = 0
					hl.Parent = plr.Character
				else
					existing.FillColor = State.ESPFillColor
					existing.OutlineColor = State.ESPOutlineColor
				end
			elseif existing then
				existing:Destroy()
			end
		end
	end
end

local function UpdateNameplateESP(enabled)
	State.NameplateESP = enabled
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and plr.Character then
			local head = plr.Character:FindFirstChild("Head")
			if head then
				local existing = head:FindFirstChild("ChelseaaNameTag")
				if enabled then
					if not existing then
						local bb = Instance.new("BillboardGui")
						bb.Name = "ChelseaaNameTag"
						bb.Size = UDim2.new(0, 140, 0, 34)
						bb.StudsOffset = Vector3.new(0, 2.5, 0)
						bb.AlwaysOnTop = true
						bb.Parent = head
						local tl = Instance.new("TextLabel")
						tl.Size = UDim2.new(1, 0, 1, 0)
						tl.BackgroundTransparency = 1
						tl.Text = plr.DisplayName .. " (@" .. plr.Name .. ")"
						tl.Font = Enum.Font.GothamBold
						tl.TextSize = 11
						tl.TextColor3 = Color3.fromRGB(56, 189, 248)
						tl.TextStrokeTransparency = 0.2
						tl.Parent = bb
					end
				elseif existing then
					existing:Destroy()
				end
			end
		end
	end
end

local function ToggleCharacterAura(auraClass, auraName)
	local root = GetRootPart()
	if not root then return end
	local existing = root:FindFirstChild(auraName)
	if existing then
		existing:Destroy()
		SetStatus("Removed " .. auraName)
	else
		local inst = Instance.new(auraClass)
		inst.Name = auraName
		inst.Parent = root
		SetStatus("Activated " .. auraName)
	end
end

local function SetXRayWalls(enabled, alpha)
	State.XRayActive = enabled
	local targetAlpha = alpha or 0.65
	for _, v in ipairs(Workspace:GetDescendants()) do
		if v:IsA("BasePart") and not v:IsDescendantOf(GetCharacter() or Instance.new("Folder")) then
			if enabled then
				if v:GetAttribute("ChelseaaOrigTrans") == nil then
					if v.Transparency < 0.5 and v.CanCollide then
						v:SetAttribute("ChelseaaOrigTrans", v.Transparency)
						v.Transparency = targetAlpha
					end
				else
					v.Transparency = targetAlpha
				end
			else
				local orig = v:GetAttribute("ChelseaaOrigTrans")
				if orig ~= nil then
					v.Transparency = orig
					v:SetAttribute("ChelseaaOrigTrans", nil)
				end
			end
		end
	end
end

local function ClearAllSpawnedObjects()
	for _, p in ipairs(SpawnedObjects) do
		if p and p.Parent then p:Destroy() end
	end
	SpawnedObjects = {}
end

local function SpawnCustomPart(size, offsetCF, color, material, trans, bouncy)
	local root = GetRootPart()
	if not root then return nil end
	local part = Instance.new("Part")
	part.Name = "ChelseaaSpawnedPart"
	part.Size = size
	part.Anchored = true
	part.CanCollide = true
	part.Material = material or Enum.Material.Neon
	part.Color = color or Color3.fromRGB(220, 38, 68)
	part.Transparency = trans or 0.25
	part.CFrame = root.CFrame * offsetCF
	if bouncy then
		part.CustomPhysicalProperties = PhysicalProperties.new(1, 0.3, 1, 1, 100)
		part.Touched:Connect(function(hit)
			if hit and hit.Parent == GetCharacter() then
				local hrp = GetRootPart()
				if hrp then
					hrp.AssemblyLinearVelocity = Vector3.new(hrp.AssemblyLinearVelocity.X, bouncy, hrp.AssemblyLinearVelocity.Z)
				end
			end
		end)
	end
	part.Parent = Workspace
	table.insert(SpawnedObjects, part)
	return part
end

local function ApplyCharacterScale(scaleMult, widthMult, heightMult)
	local hum = GetHumanoid()
	if not hum then return end
	local w = widthMult or scaleMult
	local h = heightMult or scaleMult
	local scales = {
		BodyDepthScale = w,
		BodyWidthScale = w,
		BodyHeightScale = h,
		HeadScale = scaleMult,
	}
	for name, val in pairs(scales) do
		local nv = hum:FindFirstChild(name)
		if nv and nv:IsA("NumberValue") then
			nv.Value = val
		end
	end
end

local function ApplyClientHeadless(enabled)
	State.ClientHeadless = enabled
	local char = GetCharacter()
	if not char then return end
	local head = char:FindFirstChild("Head")
	if head and head:IsA("BasePart") then
		head.Transparency = enabled and 1 or 0
		for _, child in ipairs(head:GetChildren()) do
			if child:IsA("Decal") or child:IsA("Texture") then
				child.Transparency = enabled and 1 or 0
			end
		end
	end
end

local function ApplyClientKorblox(enabled)
	State.ClientKorblox = enabled
	local char = GetCharacter()
	if not char then return end
	local r15Parts = { "RightUpperLeg", "RightLowerLeg", "RightFoot" }
	local r6Part = char:FindFirstChild("Right Leg")
	local attachTarget = char:FindFirstChild("RightUpperLeg") or r6Part
	local oldMeshPart = char:FindFirstChild("ChelseaaKorbloxLeg")
	if oldMeshPart then oldMeshPart:Destroy() end
	if enabled then
		for _, partName in ipairs(r15Parts) do
			local p = char:FindFirstChild(partName)
			if p and p:IsA("BasePart") then p.Transparency = 1 end
		end
		if r6Part and r6Part:IsA("BasePart") then r6Part.Transparency = 1 end
		if attachTarget and attachTarget:IsA("BasePart") then
			local kPart = Instance.new("Part")
			kPart.Name = "ChelseaaKorbloxLeg"
			kPart.Size = Vector3.new(1, 2, 1)
			kPart.CanCollide = false
			kPart.Massless = true
			kPart.Color = Color3.fromRGB(45, 52, 68)
			kPart.Material = Enum.Material.SmoothPlastic
			kPart.CFrame = attachTarget.CFrame * CFrame.new(0, -0.35, 0)
			kPart.Parent = char
			local mesh = Instance.new("SpecialMesh")
			mesh.MeshType = Enum.MeshType.FileMesh
			mesh.MeshId = "rbxassetid://101851696"
			mesh.TextureId = "rbxassetid://101851254"
			mesh.Scale = Vector3.new(1, 1, 1)
			mesh.Parent = kPart
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = attachTarget
			weld.Part1 = kPart
			weld.Parent = kPart
		end
	else
		for _, partName in ipairs(r15Parts) do
			local p = char:FindFirstChild(partName)
			if p and p:IsA("BasePart") then p.Transparency = 0 end
		end
		if r6Part and r6Part:IsA("BasePart") then r6Part.Transparency = 0 end
	end
end

local function UpdateHorsemanArmPose(char)
	if not char then return end
	local r15Shoulder = char:FindFirstChild("RightShoulder", true)
	local r15Elbow = char:FindFirstChild("RightElbow", true)
	local r15Wrist = char:FindFirstChild("RightWrist", true)
	if r15Shoulder and r15Shoulder:IsA("Motor6D") then
		r15Shoulder.Transform = CFrame.Angles(math.rad(56), math.rad(12), math.rad(-14))
		if r15Elbow and r15Elbow:IsA("Motor6D") then
			r15Elbow.Transform = CFrame.Angles(math.rad(32), 0, 0)
		end
		if r15Wrist and r15Wrist:IsA("Motor6D") then
			r15Wrist.Transform = CFrame.Angles(math.rad(-12), 0, 0)
		end
		return
	end
	local torso = char:FindFirstChild("Torso")
	local r6Shoulder = torso and torso:FindFirstChild("Right Shoulder")
	if r6Shoulder and r6Shoulder:IsA("Motor6D") then
		r6Shoulder.Transform = CFrame.Angles(0, 0, math.rad(68)) * CFrame.Angles(0, math.rad(-16), 0)
	end
end

local function ApplyClientHeadlessHorseman(enabled)
	State.ClientHeadlessHorseman = enabled
	local char = GetCharacter()
	if not char then return end
	local oldHeld = char:FindFirstChild("ChelseaaHorsemanHeldHead")
	if oldHeld then oldHeld:Destroy() end
	local oldNeck = char:FindFirstChild("ChelseaaHorsemanNeckFlame", true)
	if oldNeck then oldNeck:Destroy() end
	local head = char:FindFirstChild("Head")
	if enabled then
		if head and head:IsA("BasePart") then
			head.Transparency = 1
			for _, child in ipairs(head:GetChildren()) do
				if child:IsA("Decal") or child:IsA("Texture") then child.Transparency = 1 end
			end
		end
		UpdateHorsemanArmPose(char)
		local root = GetRootPart()
		local isR15 = char:FindFirstChild("RightHand") ~= nil
		local handPart = char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm")
		if handPart and handPart:IsA("BasePart") then
			local heldHead = Instance.new("Part")
			heldHead.Name = "ChelseaaHorsemanHeldHead"
			heldHead.Size = Vector3.new(1.25, 1.25, 1.25)
			heldHead.CanCollide = false
			heldHead.Massless = true
			heldHead.Color = Color3.fromRGB(255, 115, 0)
			heldHead.Material = Enum.Material.Neon
			if root then
				local forwardDir = root.CFrame.LookVector
				local rightDir = root.CFrame.RightVector
				local palmOffset = isR15 and (forwardDir * 0.35 + Vector3.new(0, 0.38, 0) - rightDir * 0.05) or (forwardDir * 0.85 + Vector3.new(0, -0.15, 0) - rightDir * 0.08)
				local headPos = handPart.Position + palmOffset
				heldHead.CFrame = CFrame.lookAt(headPos, headPos + forwardDir, Vector3.yAxis) * CFrame.Angles(math.rad(10), math.rad(12), 0)
			else
				local fallbackOffset = isR15 and (CFrame.new(0, 0.35, -0.35) * CFrame.Angles(math.rad(-75), 0, 0)) or (CFrame.new(0, -0.85, -0.45) * CFrame.Angles(math.rad(-65), 0, 0))
				heldHead.CFrame = handPart.CFrame * fallbackOffset
			end
			heldHead.Parent = char
			local mesh = Instance.new("SpecialMesh")
			mesh.MeshType = Enum.MeshType.FileMesh
			mesh.MeshId = "rbxassetid://16627529"
			mesh.TextureId = "rbxassetid://16627494"
			mesh.Scale = Vector3.new(1.18, 1.18, 1.18)
			mesh.Parent = heldHead
			local hFire = Instance.new("Fire")
			hFire.Name = "HalloweenFire"
			hFire.Color = Color3.fromRGB(255, 110, 0)
			hFire.SecondaryColor = Color3.fromRGB(168, 35, 255)
			hFire.Size = 4.5
			hFire.Heat = 8
			hFire.Parent = heldHead
			local hLight = Instance.new("PointLight")
			hLight.Color = Color3.fromRGB(255, 125, 20)
			hLight.Brightness = 2.2
			hLight.Range = 12
			hLight.Parent = heldHead
			local hSparkles = Instance.new("Sparkles")
			hSparkles.SparkleColor = Color3.fromRGB(255, 145, 0)
			hSparkles.Parent = heldHead
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = handPart
			weld.Part1 = heldHead
			weld.Parent = heldHead
		end
		local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
		if torso and torso:IsA("BasePart") then
			local neckAtt = Instance.new("Attachment")
			neckAtt.Name = "ChelseaaHorsemanNeckFlame"
			neckAtt.Position = Vector3.new(0, torso.Size.Y * 0.5, 0)
			neckAtt.Parent = torso
			local neckFire = Instance.new("Fire")
			neckFire.Color = Color3.fromRGB(255, 95, 0)
			neckFire.SecondaryColor = Color3.fromRGB(145, 25, 255)
			neckFire.Size = 2.5
			neckFire.Heat = 5
			neckFire.Parent = neckAtt
		end
	else
		local r15Shoulder = char:FindFirstChild("RightShoulder", true)
		local r15Elbow = char:FindFirstChild("RightElbow", true)
		local r15Wrist = char:FindFirstChild("RightWrist", true)
		if r15Shoulder and r15Shoulder:IsA("Motor6D") then r15Shoulder.Transform = CFrame.new() end
		if r15Elbow and r15Elbow:IsA("Motor6D") then r15Elbow.Transform = CFrame.new() end
		if r15Wrist and r15Wrist:IsA("Motor6D") then r15Wrist.Transform = CFrame.new() end
		local torso = char:FindFirstChild("Torso")
		local r6Shoulder = torso and torso:FindFirstChild("Right Shoulder")
		if r6Shoulder and r6Shoulder:IsA("Motor6D") then r6Shoulder.Transform = CFrame.new() end
		if not State.ClientHeadless and head and head:IsA("BasePart") then
			head.Transparency = 0
			for _, child in ipairs(head:GetChildren()) do
				if child:IsA("Decal") or child:IsA("Texture") then child.Transparency = 0 end
			end
		end
	end
end

local function LoadCustomMenuImage(url, fileName)
	local resolved = ""
	pcall(function()
		local getAsset = getcustomasset or getsynasset
		if type(getAsset) == "function" and type(writefile) == "function" then
			local rawBytes = game:HttpGet(url)
			if rawBytes and #rawBytes > 0 then
				writefile(fileName, rawBytes)
				resolved = getAsset(fileName)
			end
		end
	end)
	return resolved
end

-- Forward references for UI updates
local ApplyUITheme = function(_) end
local ToggleMenuWallpaper = function(_) end
local SetWallpaperTransparency = function(_) end
local CenterMainWindow = function() end
local SetClearGlassMode = function(_) end

--// =========================================================================
--// 520+ GENUINE FEATURES REGISTRY
--// =========================================================================
local Commands = {}
local New100Features = {}
local CommandLookup = {}

local function RegisterCommand(name, category, subTag, desc, isFeatured, callback)
	local idx = #Commands + 1
	local entry = {
		id = idx,
		name = name,
		category = category,
		subTag = subTag,
		desc = desc,
		isNew100 = isFeatured or false,
		run = function()
			callback()
			SetStatus(string.format("[#%d] %s", idx, desc))
		end,
	}
	Commands[idx] = entry
	CommandLookup[string.lower(name)] = entry
	CommandLookup[tostring(idx)] = entry
	if isFeatured then
		table.insert(New100Features, entry)
	end
end

-- 1. Visual, ESP & World Shaders
RegisterCommand("Player Highlight ESP ON", "Visual/ESP", "Visual/ESP", "Highlight all players through walls (Crimson/Cyan)", true, function() UpdatePlayerESP(true) end)
RegisterCommand("Player Highlight ESP OFF", "Visual/ESP", "Visual/ESP", "Disable Player Highlight ESP", true, function() UpdatePlayerESP(false) end)
RegisterCommand("Nameplate & Tag ESP ON", "Visual/ESP", "Visual/ESP", "Show floating player DisplayNames through walls", true, function() UpdateNameplateESP(true) end)
RegisterCommand("Nameplate & Tag ESP OFF", "Visual/ESP", "Visual/ESP", "Remove floating player nameplates", true, function() UpdateNameplateESP(false) end)
RegisterCommand("X-Ray Walls ON", "Visual/ESP", "Visual/ESP", "Make solid map walls semi-transparent (X-Ray)", true, function() SetXRayWalls(true, 0.65) end)
RegisterCommand("X-Ray Walls OFF", "Visual/ESP", "Visual/ESP", "Restore solid wall transparency", true, function() SetXRayWalls(false) end)
RegisterCommand("Rainbow Character ON", "Visual/ESP", "Visual/ESP", "Cycle smooth RGB neon colors across avatar", true, function() State.RainbowChar = true end)
RegisterCommand("Rainbow Character OFF", "Visual/ESP", "Visual/ESP", "Stop Rainbow Character color cycle", true, function() State.RainbowChar = false end)
RegisterCommand("ForceField Body Shield", "Visual/ESP", "Visual/ESP", "Apply glowing ForceField material to avatar", true, function() local char = GetCharacter() if char then for _, p in ipairs(char:GetDescendants()) do if p:IsA("BasePart") then p.Material = Enum.Material.ForceField end end end end)
RegisterCommand("Neon Glow Body", "Visual/ESP", "Visual/ESP", "Apply bright Neon material to avatar parts", true, function() local char = GetCharacter() if char then for _, p in ipairs(char:GetDescendants()) do if p:IsA("BasePart") then p.Material = Enum.Material.Neon end end end end)
RegisterCommand("Fire Aura Toggle", "Visual/ESP", "Visual/ESP", "Toggle blazing Fire aura on HumanoidRootPart", true, function() ToggleCharacterAura("Fire", "ChelseaaFireAura") end)
RegisterCommand("Sparkles Aura Toggle", "Visual/ESP", "Visual/ESP", "Toggle cyber Sparkles aura on HumanoidRootPart", true, function() ToggleCharacterAura("Sparkles", "ChelseaaSparklesAura") end)
RegisterCommand("Smoke Aura Toggle", "Visual/ESP", "Visual/ESP", "Toggle dark Smoke aura on HumanoidRootPart", true, function() ToggleCharacterAura("Smoke", "ChelseaaSmokeAura") end)
RegisterCommand("Cyber Trail Toggle", "Visual/ESP", "Visual/ESP", "Attach glowing crimson-cyan motion trail behind you", true, function() local root = GetRootPart() if not root then return end local old = root:FindFirstChild("ChelseaaTrail") if old then old:Destroy() return end local a0 = Instance.new("Attachment", root) a0.Position = Vector3.new(0, 1.5, 0) local a1 = Instance.new("Attachment", root) a1.Position = Vector3.new(0, -1.5, 0) local tr = Instance.new("Trail") tr.Name = "ChelseaaTrail" tr.Attachment0 = a0 tr.Attachment1 = a1 tr.Lifetime = 0.6 tr.Color = ColorSequence.new(Color3.fromRGB(220, 38, 68), Color3.fromRGB(56, 189, 248)) tr.Parent = root end)
RegisterCommand("Fullbright Max", "Visual/ESP", "Visual/ESP", "Maximum daylight brightness with zero shadows", true, function() Lighting.Brightness = 3 Lighting.ClockTime = 14 Lighting.FogEnd = 100000 Lighting.GlobalShadows = false Lighting.Ambient = Color3.fromRGB(180, 180, 180) end)
RegisterCommand("Midnight Obsidian Sky", "Visual/ESP", "Visual/ESP", "Switch world sky to sleek dark midnight mode", true, function() Lighting.ClockTime = 0 Lighting.Brightness = 1 Lighting.Ambient = Color3.fromRGB(35, 35, 50) end)
RegisterCommand("Cyber Crimson Shader", "Visual/ESP", "Visual/ESP", "Apply red-tinted cyber-anime atmosphere lighting", true, function() Lighting.Ambient = Color3.fromRGB(140, 30, 55) Lighting.OutdoorAmbient = Color3.fromRGB(160, 40, 70) Lighting.FogColor = Color3.fromRGB(45, 10, 20) Lighting.FogEnd = 800 end)
RegisterCommand("Golden Sunset Shader", "Visual/ESP", "Visual/ESP", "Apply warm golden hour sunset lighting", true, function() Lighting.ClockTime = 17.8 Lighting.Ambient = Color3.fromRGB(150, 105, 65) Lighting.OutdoorAmbient = Color3.fromRGB(180, 120, 70) end)
RegisterCommand("Night Vision Emerald Shader", "Visual/ESP", "Visual/ESP", "Bright emerald-green night vision filter", true, function() Lighting.Brightness = 2.5 Lighting.Ambient = Color3.fromRGB(40, 180, 90) Lighting.OutdoorAmbient = Color3.fromRGB(50, 210, 110) Lighting.GlobalShadows = false end)
RegisterCommand("Noir Monochrome Filter", "Visual/ESP", "Visual/ESP", "Turn world colors into dramatic black-and-white cinema", true, function() local cc = Lighting:FindFirstChild("ChelseaaNoir") or Instance.new("ColorCorrectionEffect", Lighting) cc.Name = "ChelseaaNoir" cc.Enabled = true cc.Saturation = -1 cc.Contrast = 0.25 end)
RegisterCommand("Neon Cyber Bloom FX", "Visual/ESP", "Visual/ESP", "Add bright neon bloom glow to light sources", true, function() local bl = Lighting:FindFirstChild("ChelseaaBloom") or Instance.new("BloomEffect", Lighting) bl.Name = "ChelseaaBloom" bl.Enabled = true bl.Intensity = 0.85 bl.Size = 24 end)
RegisterCommand("SunRays God-Beam FX", "Visual/ESP", "Visual/ESP", "Enable warm sunbeam light shafts across sky", true, function() local sr = Lighting:FindFirstChild("ChelseaaSunRays") or Instance.new("SunRaysEffect", Lighting) sr.Name = "ChelseaaSunRays" sr.Enabled = true sr.Intensity = 0.25 end)
RegisterCommand("PointLight Body Lantern ON", "Visual/ESP", "Visual/ESP", "Attach warm glowing lantern light around your avatar", true, function() local root = GetRootPart() if root and not root:FindFirstChild("ChelseaaLantern") then local pl = Instance.new("PointLight") pl.Name = "ChelseaaLantern" pl.Brightness = 2.2 pl.Range = 28 pl.Color = Color3.fromRGB(255, 225, 185) pl.Parent = root end end)
RegisterCommand("PointLight Body Lantern OFF", "Visual/ESP", "Visual/ESP", "Turn off avatar lantern light", true, function() local root = GetRootPart() local pl = root and root:FindFirstChild("ChelseaaLantern") if pl then pl:Destroy() end end)
RegisterCommand("Chams Box Nearest Player", "Visual/ESP", "Visual/ESP", "Draw 3D cyber selection box around nearest player", true, function() local nearRoot = FindNearestPlayerRoot() if nearRoot and nearRoot.Parent then local old = nearRoot.Parent:FindFirstChild("ChelseaaChamsBox") if old then old:Destroy() end local sb = Instance.new("SelectionBox") sb.Name = "ChelseaaChamsBox" sb.Adornee = nearRoot.Parent sb.Color3 = Color3.fromRGB(56, 189, 248) sb.LineThickness = 0.04 sb.Parent = nearRoot.Parent end end)
RegisterCommand("Clear Player Chams Boxes", "Visual/ESP", "Visual/ESP", "Remove all 3D selection boxes on players", true, function() for _, plr in ipairs(Players:GetPlayers()) do if plr.Character then local sb = plr.Character:FindFirstChild("ChelseaaChamsBox") if sb then sb:Destroy() end end end end)
RegisterCommand("Hide Terrain Water", "Visual/ESP", "Visual/ESP", "Make map water crystal clear / invisible", true, function() if Workspace.Terrain then Workspace.Terrain.WaterTransparency = 1 end end)
RegisterCommand("Remove Map Fog", "Visual/ESP", "Visual/ESP", "Clear all distance fog for crystal-clear vision", true, function() Lighting.FogEnd = 1000000 Lighting.FogStart = 999999 end)
RegisterCommand("FPS Booster LowGFX", "Visual/ESP", "Visual/ESP", "Convert parts to SmoothPlastic & hide decals for max FPS", true, function() for _, v in ipairs(Workspace:GetDescendants()) do if v:IsA("BasePart") then v.Material = Enum.Material.SmoothPlastic v.Reflectance = 0 elseif v:IsA("Decal") or v:IsA("Texture") then v.Transparency = 1 end end end)
RegisterCommand("Disable Map Particles", "Visual/ESP", "Visual/ESP", "Turn off laggy ParticleEmitters & Beams in map", true, function() for _, v in ipairs(Workspace:GetDescendants()) do if v:IsA("ParticleEmitter") or v:IsA("Beam") then v.Enabled = false end end end)
RegisterCommand("Disable Global Shadows", "Visual/ESP", "Visual/ESP", "Turn off world shadows for brighter vision & smoother FPS", true, function() Lighting.GlobalShadows = false end)
RegisterCommand("Restore Default Lighting", "Visual/ESP", "Visual/ESP", "Reset lighting, shaders & fog back to original map settings", true, function() for k, v in pairs(OriginalLighting) do Lighting[k] = v end for _, fxName in ipairs({ "ChelseaaNoir", "ChelseaaBloom", "ChelseaaSunRays", "ChelseaaCC" }) do local fx = Lighting:FindFirstChild(fxName) if fx then fx:Destroy() end end end)

-- 2. Camera & Spectate
RegisterCommand("Camera FOV 60 (Sniper Zoom)", "Camera", "Camera", "Set tight sniper zoom Field of View (60)", true, function() if Workspace.CurrentCamera then Workspace.CurrentCamera.FieldOfView = 60 end end)
RegisterCommand("Camera FOV 70 (Default)", "Camera", "Camera", "Reset Field of View to standard Roblox default (70)", true, function() if Workspace.CurrentCamera then Workspace.CurrentCamera.FieldOfView = 70 end end)
RegisterCommand("Camera FOV 90 (Wide)", "Camera", "Camera", "Set wide action Field of View (90)", true, function() if Workspace.CurrentCamera then Workspace.CurrentCamera.FieldOfView = 90 end end)
RegisterCommand("Camera FOV 105 (Pro)", "Camera", "Camera", "Set competitive wide Field of View (105)", true, function() if Workspace.CurrentCamera then Workspace.CurrentCamera.FieldOfView = 105 end end)
RegisterCommand("Camera FOV 120 (Ultra)", "Camera", "Camera", "Set maximum ultra-wide Field of View (120)", true, function() if Workspace.CurrentCamera then Workspace.CurrentCamera.FieldOfView = 120 end end)
RegisterCommand("FreeCam Detach Mode ON", "Camera", "Camera", "Detach camera to fly around map freely", true, function() local cam = Workspace.CurrentCamera if cam then State.FreeCamEnabled = true State.FreeCamCFrame = cam.CFrame cam.CameraType = Enum.CameraType.Scriptable end end)
RegisterCommand("FreeCam Detach Mode OFF", "Camera", "Camera", "Return camera back to normal character control", true, function() State.FreeCamEnabled = false local cam = Workspace.CurrentCamera local hum = GetHumanoid() if cam then cam.CameraType = Enum.CameraType.Custom if hum then cam.CameraSubject = hum end end end)
RegisterCommand("Over-Shoulder Action Cam", "Camera", "Camera", "Shift camera to a third-person over-the-shoulder angle", true, function() local hum = GetHumanoid() if hum then hum.CameraOffset = Vector3.new(2.2, 0.6, -1.2) end end)
RegisterCommand("Reset Camera Offset", "Camera", "Camera", "Reset Humanoid CameraOffset to center", true, function() local hum = GetHumanoid() if hum then hum.CameraOffset = Vector3.zero end end)
RegisterCommand("Unlock Zoom 500 Studs", "Camera", "Camera", "Allow zooming camera out up to 500 studs", true, function() LocalPlayer.CameraMaxZoomDistance = 500 end)
RegisterCommand("Unlock Zoom 5000 Studs", "Camera", "Camera", "Allow zooming camera out across entire map (5000)", true, function() LocalPlayer.CameraMaxZoomDistance = 5000 end)
RegisterCommand("Restore Default Zoom (128)", "Camera", "Camera", "Reset max zoom distance to standard 128 studs", true, function() LocalPlayer.CameraMaxZoomDistance = 128 end)
RegisterCommand("First Person Mode", "Camera", "Camera", "Lock camera into First-Person perspective", true, function() LocalPlayer.CameraMode = Enum.CameraMode.LockFirstPerson end)
RegisterCommand("Third Person Classic", "Camera", "Camera", "Unlock Third-Person camera perspective", true, function() LocalPlayer.CameraMode = Enum.CameraMode.Classic LocalPlayer.CameraMinZoomDistance = 0.5 end)
RegisterCommand("Spectate Nearest Player", "Camera", "Camera", "Focus camera onto the closest player near you", true, function() local nearRoot = FindNearestPlayerRoot() local cam = Workspace.CurrentCamera if nearRoot and nearRoot.Parent and cam then local hum = nearRoot.Parent:FindFirstChildOfClass("Humanoid") if hum then cam.CameraSubject = hum end end end)
RegisterCommand("Spectate Next Player", "Camera", "Camera", "Cycle camera view forward to the next player", true, function() local cam = Workspace.CurrentCamera if not cam then return end local pool = {} for _, plr in ipairs(Players:GetPlayers()) do if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChildOfClass("Humanoid") then table.insert(pool, plr.Character:FindFirstChildOfClass("Humanoid")) end end if #pool > 0 then State.SpectateIndex = (State.SpectateIndex % #pool) + 1 cam.CameraSubject = pool[State.SpectateIndex] end end)
RegisterCommand("Spectate Previous Player", "Camera", "Camera", "Cycle camera view backward to previous player", true, function() local cam = Workspace.CurrentCamera if not cam then return end local pool = {} for _, plr in ipairs(Players:GetPlayers()) do if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChildOfClass("Humanoid") then table.insert(pool, plr.Character:FindFirstChildOfClass("Humanoid")) end end if #pool > 0 then State.SpectateIndex = ((State.SpectateIndex - 2) % #pool) + 1 cam.CameraSubject = pool[State.SpectateIndex] end end)
RegisterCommand("Spectate Random Player", "Camera", "Camera", "Switch camera view to a random player in server", true, function() local cam = Workspace.CurrentCamera if not cam then return end local pool = {} for _, plr in ipairs(Players:GetPlayers()) do if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChildOfClass("Humanoid") then table.insert(pool, plr.Character:FindFirstChildOfClass("Humanoid")) end end if #pool > 0 then cam.CameraSubject = pool[math.random(1, #pool)] end end)
RegisterCommand("Reset Camera to Self", "Camera", "Camera", "Return camera focus back to your own character", true, function() State.FreeCamEnabled = false State.CameraOrbitSelf = false local cam = Workspace.CurrentCamera local hum = GetHumanoid() if cam and hum then cam.CameraType = Enum.CameraType.Custom cam.CameraSubject = hum end end)
RegisterCommand("ShiftLock Enable", "Camera", "Camera", "Enable Mouse ShiftLock toggle option", true, function() LocalPlayer.DevEnableMouseLock = true end)
RegisterCommand("Face Camera Direction", "Camera", "Camera", "Snap character rotation to match camera look angle", true, function() local root = GetRootPart() local cam = Workspace.CurrentCamera if root and cam then local look = cam.CFrame.LookVector root.CFrame = CFrame.lookAt(root.Position, root.Position + Vector3.new(look.X, 0, look.Z)) end end)
RegisterCommand("Cinematic Camera Shake", "Camera", "Camera", "Trigger brief action camera vibration effect", true, function() local hum = GetHumanoid() if hum then task.spawn(function() for i = 1, 12 do hum.CameraOffset = Vector3.new((math.random() - 0.5) * 0.5, (math.random() - 0.5) * 0.5, 0) task.wait(0.03) end hum.CameraOffset = Vector3.zero end) end end)
RegisterCommand("Clear Camera Blur/Color", "Camera", "Camera", "Disable BlurEffect & ColorCorrection post-processing", true, function() for _, fx in ipairs(Lighting:GetChildren()) do if fx:IsA("BlurEffect") or fx:IsA("ColorCorrectionEffect") or fx:IsA("DepthOfFieldEffect") then fx.Enabled = false end end end)
RegisterCommand("Cyber Contrast Enhance", "Camera", "Camera", "Add crisp ColorCorrection contrast boost", true, function() local cc = Lighting:FindFirstChild("ChelseaaCC") or Instance.new("ColorCorrectionEffect", Lighting) cc.Name = "ChelseaaCC" cc.Enabled = true cc.Contrast = 0.22 cc.Saturation = 0.18 end)
RegisterCommand("Depth of Field Focus", "Camera", "Camera", "Enable subtle background depth-of-field blur", true, function() local dof = Lighting:FindFirstChild("ChelseaaDOF") or Instance.new("DepthOfFieldEffect", Lighting) dof.Name = "ChelseaaDOF" dof.Enabled = true dof.FocusDistance = 25 dof.InFocusRadius = 35 end)

-- 3. Physics, Orbit & Movement Mechanics
RegisterCommand("Orbit Nearest Player ON", "Physics/Fun", "Physics/Fun", "Smoothly circle around the nearest player", true, function() State.OrbitPlayer = true end)
RegisterCommand("Orbit Nearest Player OFF", "Physics/Fun", "Physics/Fun", "Stop orbiting nearest player", true, function() State.OrbitPlayer = false end)
RegisterCommand("Spider Wall Climb ON", "Physics/Fun", "Physics/Fun", "Climb straight up walls when walking against them", true, function() State.SpiderClimb = true end)
RegisterCommand("Spider Wall Climb OFF", "Physics/Fun", "Physics/Fun", "Disable Spider Wall Climb", true, function() State.SpiderClimb = false end)
RegisterCommand("Auto-Strafe Circle ON", "Physics/Fun", "Physics/Fun", "Perform continuous circular combat strafe", true, function() State.AutoStrafe = true end)
RegisterCommand("Auto-Strafe Circle OFF", "Physics/Fun", "Physics/Fun", "Disable circular auto-strafe", true, function() State.AutoStrafe = false end)
RegisterCommand("Equip Click-TP Tool", "Physics/Fun", "Physics/Fun", "Add a local Click-to-Teleport tool into Backpack", true, function() local bp = LocalPlayer:FindFirstChildOfClass("Backpack") if not bp or bp:FindFirstChild("ChelseaaClickTP") then return end local tool = Instance.new("Tool") tool.Name = "ChelseaaClickTP" tool.RequiresHandle = false tool.Activated:Connect(function() local mouse = LocalPlayer:GetMouse() local root = GetRootPart() if mouse and mouse.Hit and root then root.CFrame = CFrame.new(mouse.Hit.Position + Vector3.new(0, 3.2, 0)) end end) tool.Parent = bp end)
RegisterCommand("Remove Click-TP Tool", "Physics/Fun", "Physics/Fun", "Remove local Click-TP tool from Backpack/Character", true, function() for _, container in ipairs({ LocalPlayer:FindFirstChildOfClass("Backpack"), GetCharacter() }) do local t = container and container:FindFirstChild("ChelseaaClickTP") if t then t:Destroy() end end end)
RegisterCommand("Slow Spin (Speed 5)", "Physics/Fun", "Physics/Fun", "Rotate character smoothly at speed 5", true, function() State.SpinSpeed = 5 end)
RegisterCommand("Fast Spinbot (Speed 25)", "Physics/Fun", "Physics/Fun", "Spin character rapidly at speed 25", true, function() State.SpinSpeed = 25 end)
RegisterCommand("Tornado Spin (Speed 65)", "Physics/Fun", "Physics/Fun", "Ultra-fast tornado spinbot at speed 65", true, function() State.SpinSpeed = 65 end)
RegisterCommand("Stop Character Spin", "Physics/Fun", "Physics/Fun", "Stop character rotation immediately", true, function() State.SpinSpeed = 0 end)
RegisterCommand("Moon Gravity (Low)", "Physics/Fun", "Physics/Fun", "Low lunar gravity (35) for floaty high jumps", true, function() Workspace.Gravity = 35 end)
RegisterCommand("Zero-G Space Float", "Physics/Fun", "Physics/Fun", "Near-zero gravity (5) space floating", true, function() Workspace.Gravity = 5 end)
RegisterCommand("Heavy Planet Gravity", "Physics/Fun", "Physics/Fun", "High gravity (350) for instant fast landing", true, function() Workspace.Gravity = 350 end)
RegisterCommand("Reset Standard Gravity", "Physics/Fun", "Physics/Fun", "Restore standard Roblox gravity (196.2)", true, function() Workspace.Gravity = 196.2 end)
RegisterCommand("Bunny Hop Auto-Jump ON", "Physics/Fun", "Physics/Fun", "Automatically jump continuously while moving", true, function() State.BunnyHop = true end)
RegisterCommand("Bunny Hop Auto-Jump OFF", "Physics/Fun", "Physics/Fun", "Disable Bunny Hop auto-jump", true, function() State.BunnyHop = false end)
RegisterCommand("Air Walk Sky Floor ON", "Physics/Fun", "Physics/Fun", "Walk in mid-air on an invisible dynamic floor", true, function() State.AirWalk = true end)
RegisterCommand("Air Walk Sky Floor OFF", "Physics/Fun", "Physics/Fun", "Disable mid-air walking floor", true, function() State.AirWalk = false end)
RegisterCommand("Spawn Neon Glass Platform", "Physics/Fun", "Physics/Fun", "Spawn a solid neon glass platform beneath your feet", true, function() SpawnCustomPart(Vector3.new(16, 1, 16), CFrame.new(0, -3.5, 0), Color3.fromRGB(220, 38, 68), Enum.Material.Neon, 0.35) end)
RegisterCommand("Spawn Neon Sky Bridge", "Physics/Fun", "Physics/Fun", "Spawn a 45-stud neon bridge directly in front of you", true, function() SpawnCustomPart(Vector3.new(8, 1, 45), CFrame.new(0, -3.5, -24), Color3.fromRGB(56, 189, 248), Enum.Material.Neon, 0.3) end)
RegisterCommand("Spawn High-Bounce Trampoline", "Physics/Fun", "Physics/Fun", "Spawn a bouncy launch pad beneath your avatar", true, function() SpawnCustomPart(Vector3.new(10, 1.2, 10), CFrame.new(0, -3.5, 0), Color3.fromRGB(34, 197, 94), Enum.Material.Neon, 0.2, 125) end)
RegisterCommand("Clear Spawned Objects", "Physics/Fun", "Physics/Fun", "Remove all platforms, bridges & pads spawned by hub", true, function() ClearAllSpawnedObjects() end)
RegisterCommand("Zero-Friction Ice Slide ON", "Physics/Fun", "Physics/Fun", "Make movement slippery like ice skating", true, function() local root = GetRootPart() if root then root.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0, 0, 100, 1) end end)
RegisterCommand("Zero-Friction Ice Slide OFF", "Physics/Fun", "Physics/Fun", "Restore normal ground traction", true, function() local root = GetRootPart() if root then root.CustomPhysicalProperties = nil end end)
RegisterCommand("Anti-Fling Protection ON", "Physics/Fun", "Physics/Fun", "Clamp extreme velocity spikes to prevent flinging", true, function() State.AntiFling = true end)
RegisterCommand("Anti-Fling Protection OFF", "Physics/Fun", "Physics/Fun", "Disable Anti-Fling velocity clamp", true, function() State.AntiFling = false end)
RegisterCommand("Swim in Air ON", "Physics/Fun", "Physics/Fun", "Enable mid-air swimming state anywhere", true, function() State.SwimAir = true end)
RegisterCommand("Swim in Air OFF", "Physics/Fun", "Physics/Fun", "Disable mid-air swimming state", true, function() State.SwimAir = false end)
RegisterCommand("Forward Dash Boost", "Physics/Fun", "Physics/Fun", "Instant forward momentum dash burst (+45 studs)", true, function() local root = GetRootPart() if root then root.CFrame = root.CFrame * CFrame.new(0, 0, -45) end end)
RegisterCommand("Super Sky Launch", "Physics/Fun", "Physics/Fun", "Launch character upward with vertical velocity", true, function() local root = GetRootPart() if root then root.AssemblyLinearVelocity = Vector3.new(root.AssemblyLinearVelocity.X, 140, root.AssemblyLinearVelocity.Z) end end)
RegisterCommand("Mid-Air Backflip Impulse", "Physics/Fun", "Physics/Fun", "Jump and perform a 360-degree backward flip", true, function() local root = GetRootPart() if root then root.AssemblyLinearVelocity = Vector3.new(root.AssemblyLinearVelocity.X, 65, root.AssemblyLinearVelocity.Z) task.spawn(function() for i = 1, 18 do if root and root.Parent then root.CFrame = root.CFrame * CFrame.Angles(math.rad(20), 0, 0) end task.wait(0.02) end end) end end)
RegisterCommand("Emergency Ground Snap", "Physics/Fun", "Physics/Fun", "Raycast straight down and land safely on solid floor", true, function() local root = GetRootPart() if root then local params = RaycastParams.new() params.FilterDescendantsInstances = { GetCharacter() } params.FilterType = Enum.RaycastFilterType.Exclude local hit = Workspace:Raycast(root.Position, Vector3.new(0, -1000, 0), params) if hit then root.CFrame = CFrame.new(hit.Position + Vector3.new(0, 3.2, 0)) root.AssemblyLinearVelocity = Vector3.zero end end end)

-- 4. Tween & 12-Slot Waypoints
for slot = 1, 12 do
	RegisterCommand("Save Waypoint Slot " .. slot, "Tween/Waypoints", "Tween/Waypoints", "Save current coordinates to Waypoint Slot #" .. slot, slot <= 6, function() local root = GetRootPart() if root then State.Waypoints[slot] = root.CFrame end end)
	RegisterCommand("Tween to Waypoint Slot " .. slot, "Tween/Waypoints", "Tween/Waypoints", "Smoothly tween to Waypoint Slot #" .. slot .. " at Tween Speed", slot <= 6, function() if State.Waypoints[slot] then TweenToCFrame(State.Waypoints[slot]) end end)
	RegisterCommand("Instant TP to Waypoint Slot " .. slot, "Tween/Waypoints", "Tween/Waypoints", "Instant CFrame teleport to Waypoint Slot #" .. slot, false, function() local root = GetRootPart() if root and State.Waypoints[slot] then root.CFrame = State.Waypoints[slot] end end)
end
RegisterCommand("Tween Path Loop (Slot 1 <-> 2)", "Tween/Waypoints", "Tween/Waypoints", "Continuously patrol back and forth between Slot 1 & 2", true, function() if not State.Waypoints[1] or not State.Waypoints[2] then SetStatus("Save Slot 1 and Slot 2 first!") return end State.TweenLoopActive = true task.spawn(function() local targetIdx = 1 while State.TweenLoopActive do local dest = State.Waypoints[targetIdx] if dest then local tw = TweenToCFrame(dest) if tw then tw.Completed:Wait() end end targetIdx = (targetIdx == 1) and 2 or 1 task.wait(0.15) end end) end)
RegisterCommand("Stop Tween Path Loop", "Tween/Waypoints", "Tween/Waypoints", "Stop Slot 1 <-> 2 patrol loop immediately", true, function() StopActiveTween() end)
RegisterCommand("Clear All Waypoint Slots", "Tween/Waypoints", "Tween/Waypoints", "Erase all saved coordinates in Slots 1 - 12", true, function() State.Waypoints = {} end)
RegisterCommand("Tween to Nearest Player", "Tween/Waypoints", "Tween/Waypoints", "Tween smoothly to the nearest player at Tween Speed", true, function() local nearRoot = FindNearestPlayerRoot() if nearRoot then TweenToCFrame(nearRoot.CFrame * CFrame.new(0, 0, 3)) end end)
RegisterCommand("Tween to Farthest Player", "Tween/Waypoints", "Tween/Waypoints", "Tween across the map to the farthest player", true, function() local root = GetRootPart() if not root then return end local farthest, maxDist = nil, -1 for _, plr in ipairs(Players:GetPlayers()) do if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then local d = (plr.Character.HumanoidRootPart.Position - root.Position).Magnitude if d > maxDist then maxDist = d farthest = plr.Character.HumanoidRootPart end end end if farthest then TweenToCFrame(farthest.CFrame * CFrame.new(0, 0, 3)) end end)
RegisterCommand("Tween to Highest Player", "Tween/Waypoints", "Tween/Waypoints", "Tween smoothly to the player at highest altitude", true, function() local bestRoot, maxY = nil, -math.huge for _, plr in ipairs(Players:GetPlayers()) do if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then local hrp = plr.Character.HumanoidRootPart if hrp.Position.Y > maxY then maxY = hrp.Position.Y bestRoot = hrp end end end if bestRoot then TweenToCFrame(bestRoot.CFrame * CFrame.new(0, 0, 3)) end end)
RegisterCommand("Tween to Lowest Player", "Tween/Waypoints", "Tween/Waypoints", "Tween smoothly to the player at lowest altitude", true, function() local bestRoot, minY = nil, math.huge for _, plr in ipairs(Players:GetPlayers()) do if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then local hrp = plr.Character.HumanoidRootPart if hrp.Position.Y < minY then minY = hrp.Position.Y bestRoot = hrp end end end if bestRoot then TweenToCFrame(bestRoot.CFrame * CFrame.new(0, 0, 3)) end end)
RegisterCommand("Instant TP to Nearest Player", "Tween/Waypoints", "Tween/Waypoints", "Instant CFrame teleport behind the nearest player", true, function() local root = GetRootPart() local nearRoot = FindNearestPlayerRoot() if root and nearRoot then root.CFrame = nearRoot.CFrame * CFrame.new(0, 0, 3) end end)
RegisterCommand("Instant TP to Random Player", "Tween/Waypoints", "Tween/Waypoints", "Instant CFrame teleport to a random player in server", true, function() local root = GetRootPart() if not root then return end local pool = {} for _, plr in ipairs(Players:GetPlayers()) do if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then table.insert(pool, plr.Character.HumanoidRootPart) end end if #pool > 0 then root.CFrame = pool[math.random(1, #pool)].CFrame * CFrame.new(0, 0, 3) end end)
RegisterCommand("Tween to Map Origin (0,50,0)", "Tween/Waypoints", "Tween/Waypoints", "Tween smoothly to center coordinates (0, 50, 0)", true, function() TweenToCFrame(CFrame.new(0, 50, 0)) end)
RegisterCommand("Tween High Sky (+500)", "Tween/Waypoints", "Tween/Waypoints", "Tween 500 studs straight up into the sky", true, function() local root = GetRootPart() if root then TweenToCFrame(root.CFrame + Vector3.new(0, 500, 0)) end end)
RegisterCommand("Sync Tween Speed = 2x WS ON", "Tween/Waypoints", "Tween/Waypoints", "Scale Tween Speed dynamically with WalkSpeed (2x)", true, function() State.SyncTweenToWalkSpeed = true end)
RegisterCommand("Sync Tween Speed = 2x WS OFF", "Tween/Waypoints", "Tween/Waypoints", "Use manual Tween Speed input value", true, function() State.SyncTweenToWalkSpeed = false end)
RegisterCommand("Stop Active Tween", "Tween/Waypoints", "Tween/Waypoints", "Cancel active Tween movement immediately", true, function() StopActiveTween() end)

-- 5. Automation, Tycoon, Aimbot & Timing
RegisterCommand("Auto Train Cursor ON", "Automation", "Automation", "Enable precision cursor clicker for 1x/2x/2.30x/3x/4x", true, function() State.AutoTrainEnabled = true end)
RegisterCommand("Auto Train Cursor OFF", "Automation", "Automation", "Disable Auto Train Cursor", true, function() State.AutoTrainEnabled = false end)
RegisterCommand("Auto Train Filter: All (1x-4x)", "Automation", "Automation", "Target all multiplier zones from 1x to 4x", true, function() State.AutoTrainFilter = "ALL" State.AutoTrainEnabled = true end)
RegisterCommand("Auto Train Filter: 2x+", "Automation", "Automation", "Target 2x, 2.30x, 3x, and 4x multipliers only", true, function() State.AutoTrainFilter = "2X_PLUS" State.AutoTrainEnabled = true end)
RegisterCommand("Auto Train Filter: High Max", "Automation", "Automation", "Target highest multipliers (2.30x / 3x / 4x)", true, function() State.AutoTrainFilter = "MAX_ONLY" State.AutoTrainEnabled = true end)
RegisterCommand("Auto Screen Clicker ON", "Automation", "Automation", "Auto-tap center screen continuously for rapid training", true, function() State.AutoClickerCenter = true end)
RegisterCommand("Auto Screen Clicker OFF", "Automation", "Automation", "Stop center screen auto-clicker", true, function() State.AutoClickerCenter = false end)
RegisterCommand("Auto ProximityPrompts ON", "Automation", "Automation", "Automatically trigger nearby interact/collect prompts", true, function() State.AutoPrompts = true end)
RegisterCommand("Auto ProximityPrompts OFF", "Automation", "Automation", "Disable automatic ProximityPrompt interaction", true, function() State.AutoPrompts = false end)
RegisterCommand("Auto Collect TouchItems ON", "Automation", "Automation", "Trigger touch pickup on nearby coins/orbs/items", true, function() State.AutoCollectTouch = true end)
RegisterCommand("Auto Collect TouchItems OFF", "Automation", "Automation", "Disable automatic TouchInterest item pickup", true, function() State.AutoCollectTouch = false end)
RegisterCommand("Auto Jump Obstacles ON", "Automation", "Automation", "Automatically jump over low walls/steps while walking", true, function() State.AutoObstacleJump = true end)
RegisterCommand("Auto Jump Obstacles OFF", "Automation", "Automation", "Disable automatic obstacle jump", true, function() State.AutoObstacleJump = false end)
RegisterCommand("Auto Respawn Death Spot ON", "Automation", "Automation", "Return automatically to your exact death location on respawn", true, function() State.AutoRespawnSpot = true end)
RegisterCommand("Auto Respawn Death Spot OFF", "Automation", "Automation", "Disable auto-return on respawn", true, function() State.AutoRespawnSpot = false end)
RegisterCommand("Equip First Backpack Tool", "Automation", "Automation", "Equip the first available tool from your Backpack", true, function() local hum = GetHumanoid() local bp = LocalPlayer:FindFirstChildOfClass("Backpack") if hum and bp then local tool = bp:FindFirstChildWhichIsA("Tool") if tool then hum:EquipTool(tool) end end end)
RegisterCommand("Unequip All Tools", "Automation", "Automation", "Put held tools back into Backpack", true, function() local hum = GetHumanoid() if hum then hum:UnequipTools() end end)
RegisterCommand("Anti-AFK Idle Bypass", "Automation", "Automation", "Prevent 20-minute idle disconnect kick", true, function() TrackConn(LocalPlayer.Idled:Connect(function() if VirtualUser then VirtualUser:CaptureController() VirtualUser:ClickButton2(Vector2.new()) end end)) end)
RegisterCommand("Freeze Character Position", "Automation", "Automation", "Anchor HumanoidRootPart in place", true, function() local root = GetRootPart() if root then root.Anchored = true end end)
RegisterCommand("Unfreeze Character Position", "Automation", "Automation", "Unanchor HumanoidRootPart to move freely", true, function() local root = GetRootPart() if root then root.Anchored = false end end)
RegisterCommand("Copy Current Coordinates", "Automation", "Automation", "Copy current X, Y, Z position to clipboard", true, function() local root = GetRootPart() if root then local posStr = string.format("%.2f, %.2f, %.2f", root.Position.X, root.Position.Y, root.Position.Z) if type(setclipboard) == "function" then setclipboard(posStr) end SetStatus("Coords: " .. posStr) end end)
RegisterCommand("Copy Server JobId", "Automation", "Automation", "Copy current server JobId to clipboard", true, function() if type(setclipboard) == "function" then setclipboard(game.JobId) end SetStatus("Copied JobId: " .. tostring(game.JobId)) end)
RegisterCommand("Unlock FPS Cap (240 FPS)", "Automation", "Automation", "Set max framerate cap to 240 FPS if supported", true, function() if type(setfpscap) == "function" then setfpscap(240) end end)
RegisterCommand("Battery Saver Cap (60 FPS)", "Automation", "Automation", "Limit framerate to 60 FPS for cooler device temp", true, function() if type(setfpscap) == "function" then setfpscap(60) end end)
RegisterCommand("Rejoin Current Server", "Automation", "Automation", "Reconnect immediately to current server instance", true, function() TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer) end)
RegisterCommand("Server Hop (New Server)", "Automation", "Automation", "Join another active public server", true, function() pcall(function() local raw = game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100") local data = HttpService:JSONDecode(raw) if data and data.data then for _, srv in ipairs(data.data) do if srv.id ~= game.JobId and srv.playing < srv.maxPlayers then TeleportService:TeleportToPlaceInstance(game.PlaceId, srv.id, LocalPlayer) break end end end end) end)
RegisterCommand("Tycoon Auto-Collect ON", "Automation", "Automation", "Automatically collect tycoon cash/collector pads safely", true, function() State.TycoonAutoCollect = true end)
RegisterCommand("Tycoon Auto-Collect OFF", "Automation", "Automation", "Disable tycoon auto-collect", true, function() State.TycoonAutoCollect = false end)
RegisterCommand("Tycoon Auto-Buy Buttons ON", "Automation", "Automation", "Automatically buy affordable tycoon buttons/upgrades", true, function() State.TycoonAutoBuy = true end)
RegisterCommand("Tycoon Auto-Buy Buttons OFF", "Automation", "Automation", "Disable tycoon auto-buy", true, function() State.TycoonAutoBuy = false end)
RegisterCommand("Aimbot Lock ON", "Automation", "Automation", "Smooth camera aimbot lock within FOV circle", true, function() State.AimbotEnabled = true end)
RegisterCommand("Aimbot Lock OFF", "Automation", "Automation", "Disable camera aimbot", true, function() State.AimbotEnabled = false end)
RegisterCommand("Aimbot Mode: Auto-Lock (Mobile/Tablet)", "Automation", "Automation", "Lock targets in FOV automatically without Right-Click", true, function() State.AimbotMode = "ALWAYS" State.AimbotEnabled = true end)
RegisterCommand("Aimbot Mode: Hold RMB (PC)", "Automation", "Automation", "Lock targets only when holding Right Mouse Button", true, function() State.AimbotMode = "HOLD_RMB" end)
RegisterCommand("Silent Aim ON", "Automation", "Automation", "Redirect raycast & mouse shots toward nearest FOV target", true, function() State.SilentAimEnabled = true end)
RegisterCommand("Silent Aim OFF", "Automation", "Automation", "Disable Silent Aim redirection", true, function() State.SilentAimEnabled = false end)
RegisterCommand("Combat Wall Check ON", "Automation", "Automation", "Only target enemies visible without wall obstruction", true, function() State.CombatWallCheck = true end)
RegisterCommand("Combat Wall Check OFF", "Automation", "Automation", "Allow targeting enemies behind walls", true, function() State.CombatWallCheck = false end)
RegisterCommand("Combat Team Check ON", "Automation", "Automation", "Ignore teammates in Aimbot & Silent Aim", true, function() State.CombatTeamCheck = true end)
RegisterCommand("Combat Team Check OFF", "Automation", "Automation", "Target all players regardless of team", true, function() State.CombatTeamCheck = false end)
RegisterCommand("Auto Perfect Timing ON", "Automation", "Automation", "Auto-trigger timing/parry on incoming objects with ping offset", true, function() State.AutoPerfectTiming = true end)
RegisterCommand("Auto Perfect Timing OFF", "Automation", "Automation", "Disable Auto Perfect Timing", true, function() State.AutoPerfectTiming = false end)

-- 6. Character FX, Headless, Korblox & UI Controls
RegisterCommand("Client Headless ON", "Character/UI", "Character/UI", "Make avatar head & face invisible (keeps hair/hats)", true, function() ApplyClientHeadless(true) end)
RegisterCommand("Client Headless OFF", "Character/UI", "Character/UI", "Restore avatar head & face visibility", true, function() ApplyClientHeadless(false) end)
RegisterCommand("Client Headless Horseman ON", "Character/UI", "Character/UI", "31K Robux Halloween bundle: Headless + flaming pumpkin head held in hand", true, function() ApplyClientHeadlessHorseman(true) end)
RegisterCommand("Client Headless Horseman OFF", "Character/UI", "Character/UI", "Remove Headless Horseman held head & Halloween fire", true, function() ApplyClientHeadlessHorseman(false) end)
RegisterCommand("Client Korblox ON", "Character/UI", "Character/UI", "Equip Korblox Deathspeaker right leg (R6 & R15)", true, function() ApplyClientKorblox(true) end)
RegisterCommand("Client Korblox OFF", "Character/UI", "Character/UI", "Restore normal avatar right leg", true, function() ApplyClientKorblox(false) end)
RegisterCommand("Big Head Mode (Client)", "Character/UI", "Character/UI", "Enlarge local avatar head mesh 2.2x", true, function() local char = GetCharacter() local head = char and char:FindFirstChild("Head") local mesh = head and head:FindFirstChildOfClass("SpecialMesh") if mesh then mesh.Scale = Vector3.new(2.2, 2.2, 2.2) end end)
RegisterCommand("Mini Tiny Head (Client)", "Character/UI", "Character/UI", "Shrink local avatar head mesh 0.5x", true, function() local char = GetCharacter() local head = char and char:FindFirstChild("Head") local mesh = head and head:FindFirstChildOfClass("SpecialMesh") if mesh then mesh.Scale = Vector3.new(0.5, 0.5, 0.5) end end)
RegisterCommand("Reset Head Scale", "Character/UI", "Character/UI", "Restore normal 1.0x head mesh scale", true, function() local char = GetCharacter() local head = char and char:FindFirstChild("Head") local mesh = head and head:FindFirstChildOfClass("SpecialMesh") if mesh then mesh.Scale = Vector3.new(1.25, 1.25, 1.25) end end)
RegisterCommand("Cyber Halo Crown ON", "Character/UI", "Character/UI", "Equip glowing floating neon halo ring above head", true, function() local char = GetCharacter() local head = char and char:FindFirstChild("Head") if not head or char:FindFirstChild("ChelseaaHaloCrown") then return end local halo = Instance.new("Part") halo.Name = "ChelseaaHaloCrown" halo.Shape = Enum.PartType.Cylinder halo.Size = Vector3.new(0.18, 2.1, 2.1) halo.Material = Enum.Material.Neon halo.Color = Color3.fromRGB(56, 189, 248) halo.CanCollide = false halo.Massless = true halo.CFrame = head.CFrame * CFrame.new(0, 1.25, 0) * CFrame.Angles(0, 0, math.rad(90)) halo.Parent = char local weld = Instance.new("WeldConstraint") weld.Part0 = head weld.Part1 = halo weld.Parent = halo end)
RegisterCommand("Cyber Halo Crown OFF", "Character/UI", "Character/UI", "Remove floating neon halo ring", true, function() local char = GetCharacter() local halo = char and char:FindFirstChild("ChelseaaHaloCrown") if halo then halo:Destroy() end end)
RegisterCommand("Anti-Ragdoll Lock ON", "Character/UI", "Character/UI", "Prevent falling down / ragdoll states", true, function() State.AntiRagdoll = true end)
RegisterCommand("Anti-Ragdoll Lock OFF", "Character/UI", "Character/UI", "Disable Anti-Ragdoll lock", true, function() State.AntiRagdoll = false end)
RegisterCommand("Sit Character", "Character/UI", "Character/UI", "Force local character to sit", true, function() local hum = GetHumanoid() if hum then hum.Sit = true end end)
RegisterCommand("Stand Up Character", "Character/UI", "Character/UI", "Stand up from seated state", true, function() local hum = GetHumanoid() if hum then hum.Sit = false end end)
RegisterCommand("HipHeight Float (+5)", "Character/UI", "Character/UI", "Hover 5 studs above ground via HipHeight", true, function() local hum = GetHumanoid() if hum then hum.HipHeight = 5 end end)
RegisterCommand("HipHeight Reset (0)", "Character/UI", "Character/UI", "Reset character HipHeight to default", true, function() local hum = GetHumanoid() if hum then hum.HipHeight = 0 end end)
RegisterCommand("Remove Accessories (Clean)", "Character/UI", "Character/UI", "Strip hats/accessories locally for clean hitbox view", true, function() local char = GetCharacter() if char then for _, acc in ipairs(char:GetChildren()) do if acc:IsA("Accessory") then acc:Destroy() end end end end)
RegisterCommand("Client Ghost Invisibility", "Character/UI", "Character/UI", "Make character semi-invisible locally (0.75)", true, function() local char = GetCharacter() if char then for _, p in ipairs(char:GetDescendants()) do if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then p.Transparency = 0.75 end end end end)
RegisterCommand("Restore Character Visibility", "Character/UI", "Character/UI", "Restore full opacity to character parts", true, function() local char = GetCharacter() if char then for _, p in ipairs(char:GetDescendants()) do if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then p.Transparency = 0 end end end end)
RegisterCommand("Reset All Character FX", "Character/UI", "Character/UI", "Clear all local auras, trails, halo, Headless & Korblox FX", true, function() ApplyClientHeadless(false) ApplyClientHeadlessHorseman(false) ApplyClientKorblox(false) State.RainbowChar = false local char = GetCharacter() local root = GetRootPart() if char then local halo = char:FindFirstChild("ChelseaaHaloCrown") if halo then halo:Destroy() end end if root then for _, fxName in ipairs({ "ChelseaaFireAura", "ChelseaaSparklesAura", "ChelseaaSmokeAura", "ChelseaaTrail", "ChelseaaLantern" }) do local fx = root:FindFirstChild(fxName) if fx then fx:Destroy() end end end end)
RegisterCommand("Reset Character", "Character/UI", "Character/UI", "Respawn local character cleanly", true, function() local hum = GetHumanoid() if hum then hum.Health = 0 end end)
RegisterCommand("UI Wallpaper: Show / Hide", "Character/UI", "Character/UI", "Toggle custom 16:9 background wallpaper image inside UI", true, function() State.MenuWallpaperVisible = not State.MenuWallpaperVisible ToggleMenuWallpaper(State.MenuWallpaperVisible) end)
RegisterCommand("UI Wallpaper: Ultra Clear (Full)", "Character/UI", "Character/UI", "Make 16:9 UI background wallpaper 100% sharp & vibrant", true, function() SetWallpaperTransparency(0.05) SetClearGlassMode(true) end)
RegisterCommand("UI Wallpaper: Balanced Glass", "Character/UI", "Character/UI", "Balanced 16:9 wallpaper clarity with sleek glass cards", true, function() SetWallpaperTransparency(0.12) SetClearGlassMode(false) end)
RegisterCommand("Center UI Window", "Character/UI", "Character/UI", "Reset main 16:9 window position to center of screen", true, function() CenterMainWindow() end)
RegisterCommand("Hide Roblox PlayerList", "Character/UI", "Character/UI", "Hide top-right Roblox leaderboard UI", true, function() pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, false) end) end)
RegisterCommand("Show Roblox PlayerList", "Character/UI", "Character/UI", "Restore top-right Roblox leaderboard UI", true, function() pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, true) end) end)
RegisterCommand("UI Theme: Cyber Crimson", "Character/UI", "Character/UI", "Switch UI accent to Obsidian Cyber Crimson", true, function() ApplyUITheme("CRIMSON") end)
RegisterCommand("UI Theme: Electric Cyan", "Character/UI", "Character/UI", "Switch UI accent to Neon Electric Cyan", true, function() ApplyUITheme("CYAN") end)
RegisterCommand("UI Theme: Emerald Matrix", "Character/UI", "Character/UI", "Switch UI accent to Emerald Matrix Green", true, function() ApplyUITheme("EMERALD") end)
RegisterCommand("UI Theme: Royal Violet", "Character/UI", "Character/UI", "Switch UI accent to Cyber Royal Violet", true, function() ApplyUITheme("VIOLET") end)
RegisterCommand("UI Theme: Pure Monochrome", "Character/UI", "Character/UI", "Switch UI accent to Sleek Silver Monochrome", true, function() ApplyUITheme("MONO") end)

