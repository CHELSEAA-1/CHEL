-- Client Geometric Accessories
RegisterCommand("Equip Cyber Angel Wings ON", "Character/UI", "Character/UI", "Attach glowing neon cyber wings to avatar back", true, function()
	local char = GetCharacter()
	local torso = char and (char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso"))
	if not torso or char:FindFirstChild("ChelseaaCyberWings") then return end
	local folder = Instance.new("Folder")
	folder.Name = "ChelseaaCyberWings"
	folder.Parent = char
	for _, side in ipairs({ -1, 1 }) do
		local wing = Instance.new("Part")
		wing.Size = Vector3.new(0.2, 2.8, 1.4)
		wing.Material = Enum.Material.Neon
		wing.Color = (side == -1) and Color3.fromRGB(220, 38, 68) or Color3.fromRGB(56, 189, 248)
		wing.CanCollide = false
		wing.Massless = true
		wing.CFrame = torso.CFrame * CFrame.new(side * 1.4, 0.4, 0.8) * CFrame.Angles(0, math.rad(side * -28), math.rad(side * 18))
		wing.Parent = folder
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = torso
		weld.Part1 = wing
		weld.Parent = wing
	end
end)
RegisterCommand("Equip Cyber Angel Wings OFF", "Character/UI", "Character/UI", "Remove glowing neon cyber wings", true, function()
	local char = GetCharacter()
	local w = char and char:FindFirstChild("ChelseaaCyberWings")
	if w then w:Destroy() end
end)

RegisterCommand("Equip Orbiting Energy Orb ON", "Character/UI", "Character/UI", "Attach glowing neon energy orb beside shoulder", true, function()
	local char = GetCharacter()
	local head = char and char:FindFirstChild("Head")
	if not head or char:FindFirstChild("ChelseaaEnergyOrb") then return end
	local orb = Instance.new("Part")
	orb.Name = "ChelseaaEnergyOrb"
	orb.Shape = Enum.PartType.Ball
	orb.Size = Vector3.new(0.9, 0.9, 0.9)
	orb.Material = Enum.Material.Neon
	orb.Color = Color3.fromRGB(56, 189, 248)
	orb.CanCollide = false
	orb.Massless = true
	orb.CFrame = head.CFrame * CFrame.new(1.6, 0.6, 0)
	orb.Parent = char
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = head
	weld.Part1 = orb
	weld.Parent = orb
end)
RegisterCommand("Equip Orbiting Energy Orb OFF", "Character/UI", "Character/UI", "Remove glowing neon energy orb", true, function()
