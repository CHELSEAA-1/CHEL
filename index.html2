RegisterCommand("Infinite Jump OFF", "Movement", "Movement", "Disable Infinite Jump", false, function() State.InfiniteJump = false end)
RegisterCommand("Noclip Walk-Through ON", "Movement", "Movement", "Walk seamlessly through walls and doors", false, function() State.Noclip = true end)
RegisterCommand("Noclip Walk-Through OFF", "Movement", "Movement", "Restore solid wall collision", false, function() State.Noclip = false end)
RegisterCommand("Smooth Flight Mode ON", "Movement", "Movement", "Enable directional camera flight (speed set in Tab 1)", false, function() State.Fly = true end)
RegisterCommand("Smooth Flight Mode OFF", "Movement", "Movement", "Disable Smooth Flight mode", false, function() State.Fly = false end)

