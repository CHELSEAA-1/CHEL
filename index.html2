local function GetSafeGuiParent()
	local ok, core = pcall(function() return game:GetService("CoreGui") end)
	if ok and core then
		local test = Instance.new("Folder")
		local canParent = pcall(function() test.Parent = core end)
		if canParent then
			test:Destroy()
			return core
		end
	end
	return LocalPlayer:WaitForChild("PlayerGui")
end

local GuiParent = GetSafeGuiParent()

-- Clean up previous versions if re-executed
for _, oldName in ipairs({ "ChelseaaSystemV9", "ChelseaaSystemV10", "ChelseaaSystemV11" }) do
	local old = GuiParent:FindFirstChild(oldName)
	if old then old:Destroy() end
end

