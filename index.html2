-- A. WalkSpeed Presets (16)
for _, ws in ipairs({ 8, 16, 24, 32, 45, 60, 80, 100, 125, 150, 200, 250, 350, 500, 750, 1000 }) do
	RegisterCommand("Set WalkSpeed " .. ws, "Movement", "Physics/Fun", "Set & lock WalkSpeed directly to " .. ws, false, function()
		State.WalkSpeed = ws
		State.WalkSpeedLocked = true
		local hum = GetHumanoid()
		if hum then hum.WalkSpeed = ws end
	end)
end

-- B. JumpPower Presets (14)
for _, jp in ipairs({ 25, 50, 75, 100, 125, 150, 200, 250, 300, 400, 500, 750, 1000, 1500 }) do
	RegisterCommand("Set JumpPower " .. jp, "Movement", "Physics/Fun", "Set & lock JumpPower directly to " .. jp, false, function()
		State.JumpPower = jp
		State.JumpPowerLocked = true
		local hum = GetHumanoid()
		if hum then
			hum.UseJumpPower = true
			hum.JumpPower = jp
		end
	end)
end

-- C. Fly Speed Presets (12)
for _, fs in ipairs({ 20, 40, 60, 85, 120, 160, 200, 275, 350, 500, 750, 1000 }) do
	RegisterCommand("Set Fly Speed " .. fs, "Movement", "Physics/Fun", "Set Smooth Flight speed to " .. fs .. " studs/sec", false, function()
		State.FlySpeed = fs
	end)
end

-- D. Tween Speed Presets (12)
for _, ts in ipairs({ 50, 100, 175, 250, 400, 600, 850, 1200, 1800, 2500, 4000, 6000 }) do
	RegisterCommand("Set Tween Speed " .. ts, "Tween/Waypoints", "Tween/Waypoints", "Set Tween travel speed to " .. ts .. " studs/sec", false, function()
		State.TweenSpeed = ts
		State.SyncTweenToWalkSpeed = false
	end)
end

-- E. Gravity Presets (12)
for _, g in ipairs({ 0, 5, 15, 35, 65, 100, 150, 196.2, 260, 350, 500, 900 }) do
	RegisterCommand("Set World Gravity " .. tostring(g), "Physics/Fun", "Physics/Fun", "Change Workspace gravity to " .. tostring(g), false, function()
		Workspace.Gravity = g
	end)
end

-- F. Directional Tween & Instant Nudge Steps (36)
local Directions = {
	{ label = "Forward", vec = function(d) return CFrame.new(0, 0, -d) end },
	{ label = "Backward", vec = function(d) return CFrame.new(0, 0, d) end },
	{ label = "Left", vec = function(d) return CFrame.new(-d, 0, 0) end },
	{ label = "Right", vec = function(d) return CFrame.new(d, 0, 0) end },
	{ label = "Upward", vec = function(d) return CFrame.new(0, d, 0) end },
	{ label = "Downward", vec = function(d) return CFrame.new(0, -d, 0) end },
}
for _, dir in ipairs(Directions) do
	for _, dist in ipairs({ 15, 45, 120 }) do
		RegisterCommand("Tween " .. dir.label .. " +" .. dist, "Tween/Waypoints", "Tween/Waypoints", "Smoothly tween " .. dist .. " studs " .. string.lower(dir.label), false, function()
			local root = GetRootPart()
			if root then TweenToCFrame(root.CFrame * dir.vec(dist)) end
		end)
		RegisterCommand("Nudge TP " .. dir.label .. " +" .. dist, "Tween/Waypoints", "Tween/Waypoints", "Instant CFrame shift " .. dist .. " studs " .. string.lower(dir.label), false, function()
			local root = GetRootPart()
			if root then root.CFrame = root.CFrame * dir.vec(dist) end
		end)
	end
end

-- G. Granular Camera FOV Presets (19)
for fov = 30, 120, 5 do
	RegisterCommand("Set Camera FOV " .. fov, "Camera", "Camera", "Set exact Camera Field of View to " .. fov .. " degrees", false, function()
		if Workspace.CurrentCamera then Workspace.CurrentCamera.FieldOfView = fov end
	end)
end

